# 项目同时支持 npm 与 pnpm。
#
# 下面是两个包管理器都认的配置。

registry=https://registry.npmmirror.com

# --- 以下为 pnpm 专用；npm 会静默忽略这些键 ---

# peer 依赖冲突时不中断安装（React 18 生态里常见）
strict-peer-dependencies=false

# 依赖存在项目内，避免写到用户目录
store-dir=.pnpm-store

# 扁平布局：Windows 上深层符号链接会触发 ENAMETOOLONG
node-linker=hoisted

# 新版 pnpm 默认拒绝 24 小时内发布的包，本项目的间接依赖会撞上这个限制
minimum-release-age=0

# 运行脚本前自动安装依赖，会把一次安装失败放大成「vite 不是可执行命令」
verify-deps-before-run=false
