{
  "name": "sudoku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "标准 9x9 数独 PWA —— 本地优先、数据不出本机、无障碍达标",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "bench": "vite build --ssr scripts/bench-generate.ts --outDir .tmp/bench --emptyOutDir --logLevel warn && node .tmp/bench/bench-generate.js",
    "pool:build": "vite build --ssr scripts/build-pool.ts --outDir .tmp/pool --emptyOutDir --logLevel warn && node .tmp/pool/build-pool.js",
    "perf": "vite build --ssr scripts/perf-report.ts --outDir .tmp/perf --emptyOutDir --logLevel warn && node .tmp/perf/perf-report.js",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "postinstall": "node scripts/patch-vite.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "sudoku-core": "^4.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.4",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
